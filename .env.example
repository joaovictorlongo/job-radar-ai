DATABASE_URL=postgres://jobradar:jobradar@localhost:55432/jobradar
REDIS_URL=redis://localhost:56379

COLLECTOR_USER_AGENT=job-radar-ai/0.1 (+https://github.com/joaovictorlongo/job-radar-ai)
COLLECTOR_REQUEST_INTERVAL_MS=1000
COLLECTOR_MAX_RETRIES=3

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# LLM: any OpenAI-compatible endpoint. Local Ollama example below.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b-instruct
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY_FILE=
LLM_PROMPT_VERSION=extract-v1
LLM_SCHEMA_VERSION=extract-schema-v1
LLM_STRUCTURED_MODE=json_object
LLM_REQUEST_INTERVAL_MS=0
LLM_TIMEOUT_MS=180000
# Local models are slower: 900000 for a 7B model on a laptop.
LLM_MAX_RETRIES=2
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0
